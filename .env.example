NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/nexus

JWT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Optional AI explanation layer. Leave blank to disable; scoring never needs it.
# LLM_PROVIDER: groq | gemini | openai-compatible (the last also needs LLM_BASE_URL and LLM_MODEL)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional backups for the Copilot chat, used automatically when the main model is rate limited.
# LLM_FALLBACK_MODELS: comma-separated extra models on the same provider and key (blank = a sensible default for groq).
# GEMINI_API_KEY: a free key from https://aistudio.google.com/apikey adds Gemini as a final fallback.
LLM_FALLBACK_MODELS=
GEMINI_API_KEY=
GEMINI_MODEL=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Number of trusted reverse-proxy hops in front of the API server.
# 0 = no proxy (default); 1 = single hop (e.g. nginx/load-balancer).
# Must match your actual deployment topology — wrong values allow IP spoofing.
TRUST_PROXY=0

ANALYSIS_COOLDOWN_MINUTES=15
MAX_REPOSITORIES_PER_ANALYSIS=15
MAX_REQUESTS_PER_REPOSITORY=10
# --- Career platform (all optional) ---
# Job providers. Leave blank to use only the clearly labelled demo listings.
# Remotive (remote jobs, no key; see https://remotive.com/api-documentation for terms/attribution). Set to true to enable.
REMOTIVE_ENABLED=
# Arbeitnow (free public API, no key; see https://www.arbeitnow.com/api-documentation). Set to true to enable.
ARBEITNOW_ENABLED=
# Himalayas (free public API, no key; see https://himalayas.app/jobs/api). Set to true to enable.
HIMALAYAS_ENABLED=
# Adzuna: register at https://developer.adzuna.com/ (both values required together)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# JSearch via RapidAPI: subscribe at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Seconds to cache provider search results in memory (0 disables). Check each provider's terms before raising.
JOB_CACHE_TTL_SECONDS=3600
JOB_PROVIDER_TIMEOUT_MS=8000
# Maximum accepted resume upload size in bytes.
RESUME_MAX_BYTES=5000000

# =============================================================================
# FRONTEND BUILD CONFIGURATION (apps/web)
# VITE_* variables are embedded into the frontend bundle at Vite build time.
# For local development this is not needed — Vite proxies /api/* to localhost:4000.
# For production, set this in apps/web/.env.local or as a CI/CD build variable.
# =============================================================================
# API base URL for production (e.g. https://api.example.com). Leave blank for dev.
VITE_API_BASE_URL=
